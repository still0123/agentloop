# 复制为 .env（或直接 export），至少启用一个模型。

# --- 智谱 GLM ---
LOOPSMITH_MODEL=glm-4.6
GLM_API_KEY=sk-...

# --- DeepSeek ---
# LOOPSMITH_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...

# --- 通义千问（DashScope OpenAI 兼容端点）---
# LOOPSMITH_MODEL=qwen-max
# DASHSCOPE_API_KEY=sk-...

# --- Anthropic 原生协议 ---
# LOOPSMITH_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- 任意 OpenAI 兼容端点（Ollama / vLLM / one-api 等）---
# LOOPSMITH_BASE_URL=http://localhost:11434/v1
# LOOPSMITH_API_KEY=ollama

# --- 备用模型：主模型连续失败时自动切换（逗号分隔，可跨提供商）---
# LOOPSMITH_FALLBACK_MODELS=deepseek-chat

# --- 可选调参 ---
# LOOPSMITH_MAX_TOKENS=8000
